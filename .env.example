# Variables the worker reads: the shared runtime ones (plan D-01) and its own.
# from 1 to 500: the most operations-cost marks in one ask
BATCH_SIZE=100
RUN_TIMEOUT=60s
HTTP_TIMEOUT=5s
HTTP_ATTEMPTS=3
# time between two runs (ADR-004 D10, HU-WRK-003 AC1)
DEADLINES_INTERVAL=15m
# where the health endpoint listens
HEALTH_ADDR=:8080
# internal base URL on the platform network: no trailing path, no credentials
OPERATIONS_COST_BASE_URL=http://operations-cost-api:8084
# a SERVICE token issued by multi-tour-security: `security issue-service-token worker-departure-deadlines <duration>`; a secret of
# the environment, never versioned
SERVICE_TOKEN=
